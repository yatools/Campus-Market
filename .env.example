ENVIRONMENT=production
DOMAIN=wall.example.edu.cn
PUBLIC_ORIGIN=https://wall.example.edu.cn
API_PREFIX=/api/v1
TRUSTED_HOSTS=wall.example.edu.cn,localhost
TRUSTED_PROXY_CIDRS=172.16.0.0/12
HEALTH_CHECK_TOKEN=replace-with-health-check-token
SECRET_KEY=replace-with-at-least-32-random-characters

POSTGRES_DB=wutong
POSTGRES_USER=wutong
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://wutong:replace-with-a-long-random-password@db:5432/wutong
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
AUTO_CREATE_SCHEMA=false

ALLOWED_CAMPUS_EMAIL_DOMAINS=stu.example.edu.cn,example.edu.cn
SESSION_COOKIE_NAME=wutong_session
CSRF_COOKIE_NAME=wutong_csrf
COOKIE_SECURE=true
SESSION_ROTATION_HOURS=24
SESSION_SLIDING_DAYS=7
SESSION_ABSOLUTE_DAYS=30
MAX_UPLOAD_MB=8

S3_ENDPOINT=https://s3.example.edu.cn
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_PUBLIC_BUCKET=wutong-public
S3_PRIVATE_BUCKET=wutong-private
S3_BACKUP_BUCKET=wutong-backups
S3_PUBLIC_BASE_URL=https://media.example.edu.cn
S3_USE_PATH_STYLE=true
MARKET_RESERVATION_HOURS=24
MARKET_REVIEW_BLIND_DAYS=14

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-secret
SMTP_FROM="梧桐墙 <mailer@example.com>"
SMTP_USE_SSL=true
DOCS_ENABLED=false
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=10
