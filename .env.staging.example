ENV_FILE=.env.staging
ENVIRONMENT=staging
DOMAIN=staging.local
PUBLIC_ORIGIN=http://127.0.0.1:8080
TRUSTED_HOSTS=127.0.0.1,localhost,staging.local
SECRET_KEY=replace-with-an-independent-staging-secret

POSTGRES_DB=wutong_staging
POSTGRES_USER=wutong_staging
POSTGRES_PASSWORD=replace-with-an-independent-staging-password
DATABASE_URL=postgresql://wutong_staging:replace-with-an-independent-staging-password@db:5432/wutong_staging
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
AUTO_CREATE_SCHEMA=false

ALLOWED_CAMPUS_EMAIL_DOMAINS=stu.example.edu.cn
COOKIE_SECURE=false
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
MAX_UPLOAD_MB=8

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=staging-mailer@example.com
SMTP_PASSWORD=replace-with-staging-smtp-secret
SMTP_FROM="梧桐墙 Staging <staging-mailer@example.com>"
SMTP_USE_SSL=true
DOCS_ENABLED=true
LOG_LEVEL=INFO
