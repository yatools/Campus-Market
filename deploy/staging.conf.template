limit_req_zone $binary_remote_addr zone=staging_api_limit:10m rate=20r/s;

upstream wutong_staging_api {
    server api:8000;
    keepalive 16;
}

# See default.conf.template: keepalive requires HTTP/1.1 *and* a cleared Connection header.
# = /app-config.json previously inherited neither, so it was also proxied over HTTP/1.0.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto http;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10m;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: ${CSP_MEDIA_ORIGINS}; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location /api/ {
        limit_req zone=staging_api_limit burst=40 nodelay;
        proxy_pass http://wutong_staging_api;
        proxy_buffering off;
        proxy_read_timeout 90s;
    }

    location /health/ {
        proxy_pass http://wutong_staging_api;
        access_log off;
    }
    location = /app-config.json { proxy_pass http://wutong_staging_api; access_log off; }
    location /uploads/ {
        proxy_pass http://wutong_staging_api;
    }
    location / { try_files $uri $uri/ /index.html; }
}
