{
  "name": "wutong-wall-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc -b",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:legacy-api": "node scripts/check-legacy-api.mjs",
    "generate:api": "openapi-typescript ../backend/api/openapi.yaml -o src/generated/api.d.ts && openapi-ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.27.4",
    "@tiptap/extension-image": "^3.27.4",
    "@tiptap/extension-link": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.27.4",
    "@tiptap/markdown": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@tiptap/vue-3": "^3.27.4",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.0",
      "minimatch": "^10.2.5"
    },
    "js-beautify": {
      "editorconfig": "^3.0.2",
      "glob": "^13.0.6"
    },
    "test-exclude": {
      "glob": "^13.0.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.53.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.8"
  }
}
